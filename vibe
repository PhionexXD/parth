def lerp_color(c1, c2, t):
    return tuple(int(a + (b - a) * t) for a, b in zip(c1, c2))


def interpolate_theme(t1, t2, t):
    dominant_landscape = t2["landscape_type"] if t > 0.5 else t1["landscape_type"]
    blended = {
        "name": t2["name"] if t > 0.5 else t1["name"],
        "landscape_type": dominant_landscape,
    }
    for key in t1:
        if key in ("name", "landscape_type"):
            continue
        val1 = t1[key]
        val2 = t2[key]
        if isinstance(val1, tuple):
            blended[key] = lerp_color(val1, val2, t)
        else:
            blended[key] = val1 + (val2 - val1) * t
    return blended


def render_sky(surface, theme):
    top = theme["sky_top"]
    bot = theme["sky_bottom"]
    for y in range(0, SCREEN_HEIGHT, 2):
        ratio = y / SCREEN_HEIGHT
        r = int(top[0] * (1 - ratio) + bot[0] * ratio)
        g = int(top[1] * (1 - ratio) + bot[1] * ratio)
        b = int(top[2] * (1 - ratio) + bot[2] * ratio)
        pygame.draw.rect(surface, (r, g, b), (0, y, SCREEN_WIDTH, 2))


class Particle:
    def __init__(self, x, y, vx, vy, color, radius, decay=0.96, is_feather=False):
        self.x = x
        self.y = y
        self.vx = vx
        self.vy = vy
        self.color = color
        self.radius = radius
        self.alpha = 255
        self.decay = decay
        self.is_feather = is_feather
        self.angle = random.uniform(0, 360)
        self.rot_speed = random.uniform(-8, 8)

    def update(self):
        self.x += self.vx
        self.y += self.vy
        if self.is_feather:
            self.vy += 0.12
            self.vx *= 0.98
            self.angle += self.rot_speed
        self.alpha *= self.decay
        self.radius = max(0, self.radius - 0.05)

    def draw(self, surface):
        if self.alpha > 10 and self.radius > 0.5:
            p_surf = pygame.Surface((int(self.radius * 3) + 4, int(self.radius * 3) + 4), pygame.SRCALPHA)
            c = (*self.color[:3], int(self.alpha))
            center = (int(self.radius * 1.5) + 2, int(self.radius * 1.5) + 2)
            if self.is_feather:
                pygame.draw.ellipse(p_surf, c, (center[0] - self.radius, center[1] - self.radius / 2, self.radius * 2, self.radius))
            else:
                pygame.draw.circle(p_surf, c, center, int(self.radius))
            surface.blit(p_surf, (self.x - center[0], self.y - center[1]))


class Cloud:
    def __init__(self, x, y, speed, scale):
        self.x = x
        self.y = y
        self.speed = speed
        self.scale = scale

    def update(self):
        self.x -= self.speed
        if self.x < -160:
            self.x = SCREEN_WIDTH + random.randint(20, 100)
            self.y = random.randint(30, 180)

    def draw(self, surface, alpha):
        c_surf = pygame.Surface((150, 60), pygame.SRCALPHA)
        color = (255, 255, 255, int(alpha))
        pygame.draw.circle(c_surf, color, (40, 35), int(22 * self.scale))
        pygame.draw.circle(c_surf, color, (70, 25), int(30 * self.scale))
        pygame.draw.circle(c_surf, color, (105, 35), int(20 * self.scale))
        pygame.draw.ellipse(c_surf, color, (20, 25, int(105 * self.scale), int(30 * self.scale)))
        surface.blit(c_surf, (self.x, self.y))


