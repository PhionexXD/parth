    def draw(self, surface, theme):
        if theme["star_alpha"] > 5:
            for sx, sy, sr in self.stars:
                s_surf = pygame.Surface((sr * 2 + 2, sr * 2 + 2), pygame.SRCALPHA)
                pygame.draw.circle(s_surf, (255, 255, 255, int(theme["star_alpha"])), (sr + 1, sr + 1), sr)
                surface.blit(s_surf, (sx - sr, sy - sr))

        l_type = theme["landscape_type"]
        back_col = theme["scenery_back"]
        accent_col = theme["scenery_accent"]

        if l_type == "jungle":
            for tx, base_y, tw, th, crown_r in self.jungle_trees:
                pygame.draw.rect(surface, back_col, (tx - tw // 2, base_y - th, tw, th))
                pygame.draw.circle(surface, back_col, (tx, base_y - th), crown_r)
                pygame.draw.circle(surface, accent_col, (tx + 10, base_y - th - 10), crown_r - 18)
                pygame.draw.circle(surface, back_col, (tx - 18, base_y - th + 8), crown_r - 12)

        elif l_type == "village":
            for pts in self.mountains:
                pygame.draw.polygon(surface, back_col, pts)
                peak = pts[1]
                snow_pts = [peak, (peak[0] - 24, peak[1] + 32), (peak[0], peak[1] + 24), (peak[0] + 24, peak[1] + 32)]
                pygame.draw.polygon(surface, (245, 250, 255), snow_pts)

            for cx, cy, cw, ch in self.cabins:
                pygame.draw.rect(surface, (60, 45, 35), (cx, cy, cw, ch))
                roof_pts = [(cx - 8, cy), (cx + cw // 2, cy - 20), (cx + cw + 8, cy)]
                pygame.draw.polygon(surface, back_col, roof_pts)
                pygame.draw.rect(surface, accent_col, (cx + 12, cy + 10, 14, 14))
                pygame.draw.rect(surface, (45, 30, 20), (cx + cw - 16, cy - 24, 8, 14))

        elif l_type == "city":
            for bx, by, bw, bh in self.buildings:
                pygame.draw.rect(surface, back_col, (bx, by, bw, bh))
                for wx in range(bx + 6, bx + bw - 6, 10):
                    for wy in range(by + 10, by + bh - 10, 15):
                        if (wx + wy) % 3 != 0:
                            pygame.draw.rect(surface, accent_col, (wx, wy, 4, 7))

        elif l_type == "desert":
            for pts in self.pyramids:
                pygame.draw.polygon(surface, back_col, pts)
                shadow_pts = [pts[1], (pts[1][0] + (pts[2][0] - pts[1][0]) // 3, pts[2][1]), pts[2]]
                pygame.draw.polygon(surface, (int(back_col[0] * 0.7), int(back_col[1] * 0.7), int(back_col[2] * 0.7)), shadow_pts)
            pygame.draw.ellipse(surface, accent_col, (-40, SCREEN_HEIGHT - 135, SCREEN_WIDTH + 80, 75))

        elif l_type == "volcano":
            for pts in self.volcano_crags:
                pygame.draw.polygon(surface, back_col, pts)
                pygame.draw.line(surface, accent_col, pts[1], (pts[1][0] + 15, pts[1][1] + 65), 3)
                pygame.draw.line(surface, accent_col, (pts[1][0] + 15, pts[1][1] + 65), (pts[1][0] - 8, pts[1][1] + 120), 2)

        elif l_type == "candy":
            for hx, hy, hw, hh in self.candy_hills:
                pygame.draw.ellipse(surface, back_col, (hx - hw, hy - hh, hw * 2, hh * 2))
                pygame.draw.circle(surface, accent_col, (hx, hy - hh + 15), 12)
                pygame.draw.circle(surface, (255, 255, 255), (hx, hy - hh + 15), 6)


class Bird:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.radius = 17
        self.velocity = 0
        self.angle = 0
        self.wing_frame = 0

        self.gravity = 0.20
        self.jump_strength = -5.0
        self.max_fall_speed = 5.5

        self.is_dead = False
        self.death_vx = 0
        self.death_vy = 0
        self.rot_speed = 0

    def flap(self):
        if not self.is_dead:
            self.velocity = self.jump_strength

    def trigger_death(self):
        self.is_dead = True
        self.death_vy = -6.5
        self.death_vx = -2.8
        self.rot_speed = 18.0

    def update_death(self, ground_y):
        self.death_vy += 0.35
        self.y += self.death_vy
        self.x += self.death_vx
        self.angle += self.rot_speed

        if self.y + self.radius >= ground_y:
            self.y = ground_y - self.radius
            self.death_vy = 0
            self.death_vx = 0
            self.rot_speed = 0
            return True
        return False

    def update(self):
        if not self.is_dead:
            self.velocity += self.gravity
            if self.velocity > self.max_fall_speed:
                self.velocity = self.max_fall_speed

            self.y += self.velocity
            self.wing_frame += 0.25

            target_angle = max(-30, min(70, -self.velocity * 8.5))
            self.angle += (target_angle - self.angle) * 0.2

    def draw(self, surface, skin):
        b_surf = pygame.Surface((60, 60), pygame.SRCALPHA)
        cx, cy = 30, 30

        pygame.draw.ellipse(b_surf, (0, 0, 0, 45), (cx - 16, cy + 12, 32, 10))
        pygame.draw.circle(b_surf, skin["body_grad_1"], (cx, cy), self.radius)
        pygame.draw.circle(b_surf, skin["body_grad_2"], (cx - 1, cy - 2), self.radius - 2)
        pygame.draw.circle(b_surf, skin["body_grad_3"], (cx - 4, cy - 5), self.radius - 7)
        pygame.draw.ellipse(b_surf, skin["belly"], (cx - 10, cy + 2, 18, 12))
        pygame.draw.circle(b_surf, skin["blush"], (cx + 3, cy + 6), 4)

        if self.is_dead:
            ex, ey = cx + 8, cy - 5
            pygame.draw.line(b_surf, BLACK, (ex - 4, ey - 4), (ex + 4, ey + 4), 2)
            pygame.draw.line(b_surf, BLACK, (ex - 4, ey + 4), (ex + 4, ey - 4), 2)
        else:
            pygame.draw.circle(b_surf, WHITE, (cx + 7, cy - 5), 6)
            pygame.draw.circle(b_surf, BLACK, (cx + 9, cy - 5), 3)
            pygame.draw.circle(b_surf, WHITE, (cx + 10, cy - 7), 1.5)

        beak_poly = [(cx + 11, cy - 2), (cx + 23, cy + 2), (cx + 11, cy + 7)]
        pygame.draw.polygon(b_surf, skin["beak_1"], beak_poly)
        pygame.draw.polygon(b_surf, skin["beak_2"], [(cx + 11, cy - 2), (cx + 20, cy + 2), (cx + 11, cy + 3)])

        if not self.is_dead:
            wing_y_offset = math.sin(self.wing_frame) * 4
        else:
            wing_y_offset = 6
        wing_surf = pygame.Surface((20, 14), pygame.SRCALPHA)
        pygame.draw.ellipse(wing_surf, skin["wing_base"], (0, 0, 18, 12))
        pygame.draw.ellipse(wing_surf, skin["wing_inner"], (2, 2, 12, 7))
        b_surf.blit(wing_surf, (cx - 14, cy - 3 + wing_y_offset))

        rotated_surf = pygame.transform.rotozoom(b_surf, self.angle, 1.0)
        new_rect = rotated_surf.get_rect(center=(int(self.x), int(self.y)))
        surface.blit(rotated_surf, new_rect.topleft)

    def get_mask_rect(self):
        return pygame.Rect(self.x - 12, self.y - 12, 24, 24)


class Pipe:
    def __init__(self, x):
        self.x = x
        self.width = 66
        self.gap = 145
        self.speed = 2.8
        self.passed = False

        min_top = 70
        max_top = SCREEN_HEIGHT - 120 - self.gap - 70
        self.top_height = random.randint(min_top, max_top)
        self.bottom_y = self.top_height + self.gap

    def update(self):
        self.x -= self.speed

    def draw_pipe_body(self, surface, rect, theme, is_top=False):
        x, y, w, h = rect
        if h <= 0:
            return

        body_surf = pygame.Surface((w, h))
        body_surf.fill(theme["pipe_base"])

        pygame.draw.rect(body_surf, theme["pipe_light"], (6, 0, 10, h))
        pygame.draw.rect(body_surf, theme["pipe_rim"], (10, 0, 4, h))
        pygame.draw.rect(body_surf, theme["pipe_dark"], (w - 18, 0, 10, h))
        pygame.draw.rect(body_surf, theme["pipe_shadow"], (w - 8, 0, 8, h))
        surface.blit(body_surf, (x, y))

        cap_h = 24
        cap_w = w + 10
        cap_x = x - 5
        cap_y = (y + h - cap_h) if is_top else y

        cap_surf = pygame.Surface((cap_w, cap_h))
        cap_surf.fill(theme["pipe_base"])
        pygame.draw.rect(cap_surf, theme["pipe_light"], (7, 0, 12, cap_h))
        pygame.draw.rect(cap_surf, theme["pipe_rim"], (12, 0, 5, cap_h))
        pygame.draw.rect(cap_surf, theme["pipe_dark"], (cap_w - 20, 0, 12, cap_h))
        pygame.draw.rect(cap_surf, theme["pipe_shadow"], (cap_w - 8, 0, 8, cap_h))
        pygame.draw.rect(cap_surf, BLACK, (0, 0, cap_w, cap_h), 2, border_radius=3)
        surface.blit(cap_surf, (cap_x, cap_y))

    def draw(self, surface, theme):
        self.draw_pipe_body(surface, (self.x, 0, self.width, self.top_height), theme, is_top=True)
        bottom_h = (SCREEN_HEIGHT - 90) - self.bottom_y
        self.draw_pipe_body(surface, (self.x, self.bottom_y, self.width, bottom_h), theme, is_top=False)

    def collides_with(self, bird_rect):
        top_rect = pygame.Rect(self.x - 3, 0, self.width + 6, self.top_height)
        bottom_rect = pygame.Rect(self.x - 3, self.bottom_y, self.width + 6, SCREEN_HEIGHT - self.bottom_y)
        return bird_rect.colliderect(top_rect) or bird_rect.colliderect(bottom_rect)


class Ground:
    def __init__(self):
        self.height = 90
        self.y = SCREEN_HEIGHT - self.height
        self.scroll = 0
        self.speed = 2.8

    def update(self):
        self.scroll = (self.scroll - self.speed) % 24

    def draw(self, surface, theme):
        g_rect = pygame.Rect(0, self.y, SCREEN_WIDTH, self.height)
        pygame.draw.rect(surface, theme["ground_base"], g_rect)
        pygame.draw.rect(surface, theme["grass_top"], (0, self.y, SCREEN_WIDTH, 14))
        pygame.draw.rect(surface, theme["grass_shadow"], (0, self.y + 14, SCREEN_WIDTH, 4))

        for x in range(int(self.scroll) - 24, SCREEN_WIDTH + 24, 18):
            pygame.draw.polygon(
                surface,
                theme["grass_top"],
                [(x, self.y + 14), (x + 8, self.y + 14), (x + 3, self.y + 24), (x - 5, self.y + 24)]
            )

        pygame.draw.line(surface, BLACK, (0, self.y), (SCREEN_WIDTH, self.y), 2)


# ----------------- IN-GAME SIMULATED CHECKOUT MODAL -----------------
class SimulatedCheckout:
    """A safe, purely in-game simulated checkout modal."""
    def __init__(self, screen_width, screen_height):
        self.sw = screen_width
        self.sh = screen_height
        self.active = False
        self.selected_item = None
        self.payment_methods = ["UPI / FastPay", "Card Simulation", "NetBanking"]
        self.selected_method = 0
        self.status_message = ""
        self.status_timer = 0

    def open(self, package):
        self.active = True
        self.selected_item = package
        self.status_message = ""
        self.status_timer = 0

    def close(self):
        self.active = False
        self.selected_item = None

    def handle_click(self, mouse_pos):
        if not self.active:
            return None

        tab_y = self.sh // 2 - 30
        for idx in range(len(self.payment_methods)):
            tab_rect = pygame.Rect(self.sw // 2 - 140, tab_y + (idx * 44), 280, 36)
            if tab_rect.collidepoint(mouse_pos):
                self.selected_method = idx
                return None

        pay_btn = pygame.Rect(self.sw // 2 - 140, self.sh // 2 + 110, 135, 40)
        if pay_btn.collidepoint(mouse_pos):
            reward = self.selected_item["coins"] if self.selected_item else 0
            self.status_message = f"Success! +{reward} Coins added."
            self.status_timer = 45
            return reward

        cancel_btn = pygame.Rect(self.sw // 2 + 5, self.sh // 2 + 110, 135, 40)
        if cancel_btn.collidepoint(mouse_pos):
            self.close()

        return None

    def draw(self, surface, font, s_font):
        if not self.active:
            return

        dim = pygame.Surface((self.sw, self.sh), pygame.SRCALPHA)
        dim.fill((0, 0, 0, 185))
        surface.blit(dim, (0, 0))

        modal_rect = pygame.Rect(self.sw // 2 - 160, self.sh // 2 - 170, 320, 345)
        pygame.draw.rect(surface, (245, 248, 252), modal_rect, border_radius=18)
        pygame.draw.rect(surface, (200, 210, 225), modal_rect, width=2, border_radius=18)

        title = font.render("Simulated Checkout", True, (30, 30, 30))
        surface.blit(title, (modal_rect.centerx - title.get_width() // 2, modal_rect.y + 18))

        if self.selected_item:
            item_text = s_font.render(
                f"Item: +{self.selected_item['coins']} Coins ({self.selected_item['price']})",
                True,
                (90, 100, 110)
            )
            surface.blit(item_text, (modal_rect.centerx - item_text.get_width() // 2, modal_rect.y + 50))

        tab_y = self.sh // 2 - 30
        for idx, method in enumerate(self.payment_methods):
            tab_rect = pygame.Rect(self.sw // 2 - 140, tab_y + (idx * 44), 280, 36)
            is_active = (self.selected_method == idx)
            bg = (220, 235, 252) if is_active else (255, 255, 255)
            border = (41, 128, 185) if is_active else (210, 215, 220)

            pygame.draw.rect(surface, bg, tab_rect, border_radius=8)
            pygame.draw.rect(surface, border, tab_rect, width=2 if is_active else 1, border_radius=8)

            txt_col = (41, 128, 185) if is_active else (60, 60, 60)
            tab_txt = s_font.render(f"[Simulated] {method}", True, txt_col)
            surface.blit(tab_txt, (tab_rect.x + 12, tab_rect.y + 9))

        pay_btn = pygame.Rect(self.sw // 2 - 140, self.sh // 2 + 110, 135, 40)
        pygame.draw.rect(surface, (46, 204, 113), pay_btn, border_radius=8)
        p_txt = s_font.render("Complete (Free)", True, WHITE)
        surface.blit(p_txt, (pay_btn.centerx - p_txt.get_width() // 2, pay_btn.centery - p_txt.get_height() // 2))

        cancel_btn = pygame.Rect(self.sw // 2 + 5, self.sh // 2 + 110, 135, 40)
        pygame.draw.rect(surface, (231, 76, 60), cancel_btn, border_radius=8)
        c_txt = s_font.render("Cancel", True, WHITE)
        surface.blit(c_txt, (cancel_btn.centerx - c_txt.get_width() // 2, cancel_btn.centery - c_txt.get_height() // 2))

        if self.status_timer > 0:
            self.status_timer -= 1
            status_surf = s_font.render(self.status_message, True, (39, 174, 96))
            surface.blit(status_surf, (modal_rect.centerx - status_surf.get_width() // 2, modal_rect.bottom - 22))
            if self.status_timer == 0:
                self.close()


