                    draw_glow_text(screen, "EQUIP", small_font, WHITE, action_btn.center, (20, 100, 50))
                    if mouse_click and action_btn.collidepoint(mouse_pos):
                        active_skin_idx = idx
                        trigger_toast(f"Equipped {s['name']}!")
                else:
                    can_buy = (coins >= s["price"])
                    draw_panel(screen, action_btn, radius=10, bg_color=GOLD if can_buy else (180, 180, 180), border_color=WHITE)
                    draw_glow_text(screen, f"{s['price']} C", small_font, BLACK if can_buy else WHITE, action_btn.center, (180, 140, 0))
                    if mouse_click and action_btn.collidepoint(mouse_pos):
                        if can_buy:
                            coins -= s["price"]
                            s["unlocked"] = True
                            active_skin_idx = idx
                            trigger_toast(f"Unlocked {s['name']}!")
                        else:
                            trigger_toast("Need more coins!")

