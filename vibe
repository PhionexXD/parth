            draw_glow_text(screen, "← BACK", btn_font, WHITE, back_btn.center, (0, 0, 0))
            if mouse_click and back_btn.collidepoint(mouse_pos):
                game_state = "HOME"

        # -------------------------------------------------------------
        # STATE: PAYMENT & TOP-UP (INTEGRATED CHECKOUT MODAL)
        # -------------------------------------------------------------
        elif game_state == "PAYMENT":
            ground.draw(screen, current_theme)
            draw_panel(screen, (20, 30, SCREEN_WIDTH - 40, SCREEN_HEIGHT - 65), radius=22, bg_color=(255, 255, 255, 245), border_color=WHITE)
            draw_glow_text(screen, "COIN SHOP", title_font, BLACK, (SCREEN_WIDTH // 2, 70), (200, 200, 200))
            draw_glow_text(screen, "Instant Digital Mock Checkout", small_font, (120, 120, 120), (SCREEN_WIDTH // 2, 100), (240, 240, 240))

            draw_coin_badge(screen, coins, (SCREEN_WIDTH - 150, 50))

            packages = [
                {"coins": 100, "price": "$0.99", "badge": "STARTER", "color": (80, 170, 240)},
                {"coins": 300, "price": "$1.99", "badge": "POPULAR", "color": GOLD},
                {"coins": 750, "price": "$3.99", "badge": "BEST VALUE", "color": PURPLE_ACCENT},
                {"coins": 2000, "price": "$8.99", "badge": "VAULT", "color": CRIMSON},
            ]

            pack_y = 135
            for p in packages:
                p_rect = pygame.Rect(40, pack_y, SCREEN_WIDTH - 80, 80)
                draw_panel(screen, p_rect, radius=14, bg_color=(245, 248, 252), border_color=(210, 220, 235))

                pygame.draw.circle(screen, GOLD, (75, pack_y + 40), 18)
                pygame.draw.circle(screen, (255, 240, 120), (73, pack_y + 38), 12)
                pygame.draw.circle(screen, (180, 140, 0), (75, pack_y + 40), 18, 2)

                amt_txt = hud_font.render(f"+{p['coins']} Coins", True, (20, 20, 20))
                tag_txt = small_font.render(p["badge"], True, p["color"])
                screen.blit(amt_txt, (110, pack_y + 20))
                screen.blit(tag_txt, (110, pack_y + 42))

                buy_btn = pygame.Rect(p_rect.right - 90, pack_y + 22, 78, 36)
                draw_panel(screen, buy_btn, radius=10, bg_color=EMERALD, border_color=WHITE)
                draw_glow_text(screen, p["price"], btn_font, WHITE, buy_btn.center, (20, 100, 50))

                # Open simulated checkout modal when a package is clicked
                if not checkout.active and mouse_click and buy_btn.collidepoint(mouse_pos):
                    checkout.open(p)

                pack_y += 92

            back_btn = pygame.Rect(SCREEN_WIDTH // 2 - 80, SCREEN_HEIGHT - 85, 160, 42)
            draw_panel(screen, back_btn, radius=14, bg_color=(45, 45, 45), border_color=WHITE)
            draw_glow_text(screen, "← BACK", btn_font, WHITE, back_btn.center, (0, 0, 0))
            if not checkout.active and mouse_click and back_btn.collidepoint(mouse_pos):
                game_state = "HOME"

            # Handle Simulated Modal Clicks & Draw Modal
            if checkout.active:
                if mouse_click:
                    granted = checkout.handle_click(mouse_pos)
                    if granted:
                        coins += granted
                checkout.draw(screen, hud_font, small_font)

        # -------------------------------------------------------------
        # STATE: ACTIVE GAMEPLAY
        # -------------------------------------------------------------
        elif game_state == "PLAYING":
            bird.update()
            ground.update()

            spawn_timer += 1
            if spawn_timer > 105:
                pipes.append(Pipe(SCREEN_WIDTH + 20))
                spawn_timer = 0

            for pipe in pipes:
                pipe.update()

                if not pipe.passed and (pipe.x + pipe.width) < bird.x:
                    pipe.passed = True
                    score += 1
                    coins += 2

                    if score % 10 == 0 and score > 0:
                        from_theme_idx = to_theme_idx
                        other_themes = [i for i in range(len(THEMES)) if i != from_theme_idx]
                        to_theme_idx = random.choice(other_themes)
                        blend_progress = 0.0
                        theme_banner_timer = 110

                    if score % 2 == 0 and score > checkpoint:
                        checkpoint = score
                        coins += 10
                        checkpoint_banner_timer = 60
                        for _ in range(20):
                            particles.append(
                                Particle(
                                    bird.x, bird.y,
                                    vx=random.uniform(-4, 4),
                                    vy=random.uniform(-4, 4),
                                    color=CYAN_ACCENT,
                                    radius=random.uniform(3, 6)
                                )
                            )

            pipes = [p for p in pipes if p.x + p.width > -20]

            if bird.y + bird.radius >= ground.y or bird.y - bird.radius <= 0:
                trigger_player_death()

            bird_box = bird.get_mask_rect()
            for pipe in pipes:
                if pipe.collides_with(bird_box):
                    trigger_player_death()

            for pipe in pipes:
                pipe.draw(screen, current_theme)
            ground.draw(screen, current_theme)

            for p in particles[:]:
                p.update()
                p.draw(screen)
                if p.alpha <= 10 or p.radius <= 0.5:
                    particles.remove(p)

            bird.draw(screen, SKINS[active_skin_idx])

            draw_panel(screen, (SCREEN_WIDTH // 2 - 60, 20, 120, 52), radius=22, bg_color=(0, 0, 0, 90), border_color=(255, 255, 255, 170))
            draw_glow_text(screen, str(score), score_font, WHITE, (SCREEN_WIDTH // 2, 42), (0, 0, 0))
            draw_glow_text(screen, f"FLAG: {checkpoint}", small_font, CYAN_ACCENT, (SCREEN_WIDTH // 2, 62), (0, 0, 0))

            draw_coin_badge(screen, coins, (SCREEN_WIDTH - 125, 20))

            if theme_banner_timer > 0:
                theme_banner_timer -= 1
                bw, bh = 300, 42
                draw_panel(screen, (SCREEN_WIDTH // 2 - bw // 2, 80, bw, bh), radius=14, bg_color=(0, 0, 0, 190), border_color=current_theme["pipe_light"])
                draw_glow_text(screen, f"BIOME: {current_theme['name'].upper()}", checkpoint_font, current_theme["pipe_rim"], (SCREEN_WIDTH // 2, 101), (0, 0, 0))
            elif checkpoint_banner_timer > 0:
                checkpoint_banner_timer -= 1
                bw, bh = 250, 40
                draw_panel(screen, (SCREEN_WIDTH // 2 - bw // 2, 80, bw, bh), radius=14, bg_color=(0, 160, 210, 230), border_color=WHITE)
                draw_glow_text(screen, f"CHECKPOINT +10 COINS!", checkpoint_font, WHITE, (SCREEN_WIDTH // 2, 100), (0, 70, 100))

        # -------------------------------------------------------------
        # STATE: DYING ANIMATION
        # -------------------------------------------------------------
        elif game_state == "DYING":
            hit_ground = bird.update_death(ground.y)
            death_timer += 1

            for pipe in pipes:
                pipe.draw(screen, current_theme)
            ground.draw(screen, current_theme)

            for p in particles[:]:
                p.update()
                p.draw(screen)
                if p.alpha <= 10 or p.radius <= 0.5:
                    particles.remove(p)

            bird.draw(screen, SKINS[active_skin_idx])

            if flash_alpha > 0:
                flash_surf = pygame.Surface((SCREEN_WIDTH, SCREEN_HEIGHT), pygame.SRCALPHA)
                flash_surf.fill((255, 255, 255, int(flash_alpha)))
                screen.blit(flash_surf, (0, 0))
                flash_alpha = max(0, flash_alpha - 20)

            if hit_ground or death_timer > 80:
                game_state = "GAMEOVER"

        # -------------------------------------------------------------
        # STATE: GAME OVER MENU
        # -------------------------------------------------------------
        elif game_state == "GAMEOVER":
            for pipe in pipes:
                pipe.draw(screen, current_theme)
            ground.draw(screen, current_theme)
            bird.draw(screen, SKINS[active_skin_idx])

            mw, mh = 330, 390
            mx = SCREEN_WIDTH // 2 - mw // 2
            my = SCREEN_HEIGHT // 2 - mh // 2 - 10
            draw_panel(screen, (mx, my, mw, mh), radius=24, bg_color=(255, 255, 255, 245), border_color=WHITE)

            draw_glow_text(screen, "GAME OVER", title_font, CRIMSON, (SCREEN_WIDTH // 2, my + 38), (255, 180, 180))

            draw_panel(screen, (mx + 20, my + 72, mw - 40, 68), radius=14, bg_color=(240, 244, 248), border_color=(210, 220, 230))
            draw_glow_text(screen, f"Score: {score}   |   Coins: {coins}", hud_font, (50, 50, 50), (SCREEN_WIDTH // 2, my + 94), (200, 200, 200))
            draw_glow_text(screen, f"Best Run: {high_score}   |   Saved Flag: {checkpoint}", small_font, (90, 100, 110), (SCREEN_WIDTH // 2, my + 120), (220, 220, 220))

            draw_panel(screen, (mx + 20, my + 152, mw - 40, 44), radius=12, bg_color=(0, 168, 255, 220), border_color=(0, 130, 210))
            draw_glow_text(screen, "[SPACE / C] Continue Checkpoint", small_font, WHITE, (SCREEN_WIDTH // 2, my + 174), (0, 80, 140))

            draw_panel(screen, (mx + 20, my + 204, mw - 40, 44), radius=12, bg_color=(46, 204, 113, 220), border_color=(38, 166, 91))
            draw_glow_text(screen, "[R] Restart from Score 0", small_font, WHITE, (SCREEN_WIDTH // 2, my + 226), (25, 110, 60))

            draw_panel(screen, (mx + 20, my + 256, mw - 40, 44), radius=12, bg_color=(155, 89, 182, 220), border_color=(142, 68, 173))
            draw_glow_text(screen, "[H] Return to Home Screen", small_font, WHITE, (SCREEN_WIDTH // 2, my + 278), (80, 30, 100))

            draw_panel(screen, (mx + 20, my + 308, mw - 40, 40), radius=12, bg_color=(235, 75, 75, 220), border_color=(190, 45, 45))
            draw_glow_text(screen, "[Q / ESC] Quit Game", small_font, WHITE, (SCREEN_WIDTH // 2, my + 328), (130, 25, 25))

        # -------------------------------------------------------------
        # UNIVERSAL NOTIFICATION TOAST
        # -------------------------------------------------------------
        if toast_timer > 0:
            toast_timer -= 1
            tw, th = 260, 38
            draw_panel(screen, (SCREEN_WIDTH // 2 - tw // 2, SCREEN_HEIGHT - 65, tw, th), radius=14, bg_color=(20, 20, 20, 230), border_color=GOLD)
            draw_glow_text(screen, toast_msg, small_font, WHITE, (SCREEN_WIDTH // 2, SCREEN_HEIGHT - 46), (0, 0, 0))

        pygame.display.flip()

    pygame.quit()
    sys.exit()


if __name__ == "__main__":
    main() 