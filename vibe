    ]
    landscape = DynamicLandscape()
    particles = []
    checkout = SimulatedCheckout(SCREEN_WIDTH, SCREEN_HEIGHT)

    # Persistence & Stats
    coins = 150
    active_skin_idx = 0
    score = 0
    checkpoint = 0
    high_score = 0

    # Theme Management
    from_theme_idx = 0
    to_theme_idx = 0
    blend_progress = 1.0
    blend_speed = 0.007

    spawn_timer = 0
    checkpoint_banner_timer = 0
    theme_banner_timer = 0
    toast_msg = ""
    toast_timer = 0

    game_state = "HOME"
    death_timer = 0
    screen_shake = 0
    flash_alpha = 0

    def trigger_toast(msg):
        nonlocal toast_msg, toast_timer
        toast_msg = msg
        toast_timer = 90

    def trigger_player_death():
        nonlocal game_state, screen_shake, flash_alpha, death_timer, high_score
        game_state = "DYING"
        death_timer = 0
        screen_shake = 14
        flash_alpha = 200
        bird.trigger_death()

        skin = SKINS[active_skin_idx]
        for _ in range(25):
            angle = random.uniform(0, 2 * math.pi)
            speed = random.uniform(2, 6)
            particles.append(
                Particle(
                    bird.x, bird.y,
                    vx=math.cos(angle) * speed,
                    vy=math.sin(angle) * speed,
                    color=random.choice([skin["body_grad_1"], skin["body_grad_2"], skin["trail_color"], WHITE]),
                    radius=random.uniform(3, 7),
                    decay=0.95,
                    is_feather=True
                )
            )
        if score > high_score:
            high_score = score

    def reset_to_checkpoint():
        nonlocal bird, pipes, particles, score, spawn_timer, checkpoint_banner_timer, theme_banner_timer, game_state
        bird = Bird(80, SCREEN_HEIGHT // 2)
        pipes = [Pipe(SCREEN_WIDTH + 80)]
        particles.clear()
        score = checkpoint
        spawn_timer = 0
        checkpoint_banner_timer = 0
        theme_banner_timer = 0
        game_state = "PLAYING"
        bird.flap()

    def reset_fresh():
        nonlocal bird, pipes, particles, score, checkpoint, spawn_timer, checkpoint_banner_timer, theme_banner_timer, from_theme_idx, to_theme_idx, blend_progress, game_state
        bird = Bird(80, SCREEN_HEIGHT // 2)
        pipes = [Pipe(SCREEN_WIDTH + 80)]
        particles.clear()
        score = 0
        checkpoint = 0
        from_theme_idx = 0
        to_theme_idx = 0
        blend_progress = 1.0
        spawn_timer = 0
        checkpoint_banner_timer = 0
        theme_banner_timer = 0
        game_state = "PLAYING"
        bird.flap()

    running = True
    while running:
        clock.tick(FPS)
        mouse_pos = pygame.mouse.get_pos()
        mouse_click = False

        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
                break

            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                mouse_click = True

            if event.type == pygame.KEYDOWN:
                if game_state == "PLAYING" and event.key in (pygame.K_SPACE, pygame.K_UP):
                    bird.flap()
                    skin = SKINS[active_skin_idx]
                    for _ in range(4):
                        particles.append(
                            Particle(
                                bird.x - 10, bird.y + 6,
                                vx=random.uniform(-2, -0.5),
                                vy=random.uniform(-1, 2),
                                color=skin["trail_color"],
                                radius=random.uniform(2, 4)
                            )
                        )
                elif game_state == "GAMEOVER":
                    if event.key in (pygame.K_SPACE, pygame.K_c):
                        reset_to_checkpoint()
                    elif event.key == pygame.K_r:
                        reset_fresh()
                    elif event.key == pygame.K_h:
                        game_state = "HOME"
                    elif event.key in (pygame.K_q, pygame.K_ESCAPE):
                        running = False

        # Theme Transition Step
        if blend_progress < 1.0:
            blend_progress = min(1.0, blend_progress + blend_speed)
        current_theme = interpolate_theme(THEMES[from_theme_idx], THEMES[to_theme_idx], blend_progress)

        if screen_shake > 0:
            screen_shake -= 1

        render_sky(screen, current_theme)
        for c in clouds:
            c.update()
            c.draw(screen, alpha=current_theme["cloud_alpha"])
        landscape.draw(screen, current_theme)

        # -------------------------------------------------------------
        # STATE: HOME SCREEN
        # -------------------------------------------------------------
        if game_state == "HOME":
            ground.update()
            ground.draw(screen, current_theme)

            idle_y = 205 + math.sin(pygame.time.get_ticks() * 0.005) * 8
            bird.x = SCREEN_WIDTH // 2
            bird.y = idle_y
            bird.draw(screen, SKINS[active_skin_idx])

            draw_panel(screen, (SCREEN_WIDTH // 2 - 150, 45, 300, 105), radius=22, bg_color=(0, 0, 0, 120), border_color=(255, 255, 255, 180))
            draw_glow_text(screen, "FLAPPY BIRD", title_font, WHITE, (SCREEN_WIDTH // 2, 80), (0, 0, 0))
            draw_glow_text(screen, f"HIGH SCORE: {high_score}", hud_font, GOLD, (SCREEN_WIDTH // 2, 118), (0, 0, 0))

            play_btn = pygame.Rect(SCREEN_WIDTH // 2 - 120, 260, 240, 52)
            skins_btn = pygame.Rect(SCREEN_WIDTH // 2 - 120, 325, 240, 50)
            pay_btn = pygame.Rect(SCREEN_WIDTH // 2 - 120, 388, 240, 50)
            quit_btn = pygame.Rect(SCREEN_WIDTH // 2 - 120, 450, 240, 44)

            draw_panel(screen, play_btn, radius=16, bg_color=EMERALD if play_btn.collidepoint(mouse_pos) else (38, 175, 95), border_color=WHITE)
            draw_glow_text(screen, "▶ PLAY GAME", hud_font, WHITE, play_btn.center, (20, 100, 50))

            draw_panel(screen, skins_btn, radius=16, bg_color=PURPLE_ACCENT if skins_btn.collidepoint(mouse_pos) else (135, 70, 200), border_color=WHITE)
            draw_glow_text(screen, "✦ BIRD SKINS", hud_font, WHITE, skins_btn.center, (70, 30, 110))

            draw_panel(screen, pay_btn, radius=16, bg_color=GOLD if pay_btn.collidepoint(mouse_pos) else (215, 175, 10), border_color=WHITE)
            draw_glow_text(screen, "⚡ GET COINS", hud_font, BLACK if pay_btn.collidepoint(mouse_pos) else WHITE, pay_btn.center, (120, 90, 0))

            draw_panel(screen, quit_btn, radius=16, bg_color=(215, 55, 55) if quit_btn.collidepoint(mouse_pos) else (175, 45, 45), border_color=WHITE)
            draw_glow_text(screen, "QUIT", small_font, WHITE, quit_btn.center, (100, 20, 20))

            if mouse_click:
                if play_btn.collidepoint(mouse_pos):
                    reset_fresh()
                elif skins_btn.collidepoint(mouse_pos):
                    game_state = "SKINS"
                elif pay_btn.collidepoint(mouse_pos):
                    game_state = "PAYMENT"
                elif quit_btn.collidepoint(mouse_pos):
                    running = False

            draw_coin_badge(screen, coins, (SCREEN_WIDTH - 125, 20))

        # -------------------------------------------------------------
        # STATE: SKINS LOCKER & SHOP
        # -------------------------------------------------------------
        elif game_state == "SKINS":
            ground.draw(screen, current_theme)
            draw_panel(screen, (20, 25, SCREEN_WIDTH - 40, SCREEN_HEIGHT - 55), radius=22, bg_color=(255, 255, 255, 245), border_color=WHITE)
            draw_glow_text(screen, "SKINS LOCKER", title_font, BLACK, (SCREEN_WIDTH // 2, 60), (200, 200, 200))

            draw_coin_badge(screen, coins, (SCREEN_WIDTH - 150, 45))

            card_y = 105
            for idx, s in enumerate(SKINS):
                card_rect = pygame.Rect(40, card_y, SCREEN_WIDTH - 80, 84)
                is_equipped = (idx == active_skin_idx)

                border = GOLD if is_equipped else (210, 220, 230)
                bg = (245, 248, 252) if not is_equipped else (255, 250, 230)
                draw_panel(screen, card_rect, radius=14, bg_color=bg, border_color=border)

                sample_bird = Bird(75, card_y + 42)
                sample_bird.draw(screen, s)

                name_surf = hud_font.render(s["name"], True, (30, 30, 30))
                screen.blit(name_surf, (115, card_y + 18))

                action_btn = pygame.Rect(card_rect.right - 95, card_y + 24, 82, 36)
                if is_equipped:
                    draw_panel(screen, action_btn, radius=10, bg_color=(220, 220, 220), border_color=(180, 180, 180))
                    draw_glow_text(screen, "ACTIVE", small_font, (90, 90, 90), action_btn.center, (240, 240, 240))
                elif s["unlocked"]:
