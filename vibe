        self.candy_hills = [
            (60, SCREEN_HEIGHT - 90, 65, 85),
            (175, SCREEN_HEIGHT - 90, 85, 115),
            (295, SCREEN_HEIGHT - 90, 70, 95),
            (385, SCREEN_HEIGHT - 90, 60, 75),
