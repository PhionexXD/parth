def draw_panel(surface, rect, radius=16, bg_color=(255, 255, 255, 230), border_color=(255, 255, 255)):
    panel = pygame.Surface((rect[2], rect[3]), pygame.SRCALPHA)
    pygame.draw.rect(panel, bg_color, (0, 0, rect[2], rect[3]), border_radius=radius)
    pygame.draw.rect(panel, border_color, (0, 0, rect[2], rect[3]), 2, border_radius=radius)
    surface.blit(panel, (rect[0], rect[1]))


def draw_glow_text(surface, text, font, color, center_pos, glow_color=(0, 0, 0, 100)):
    glow_surf = font.render(text, True, glow_color[:3])
    text_surf = font.render(text, True, color)

    gx = center_pos[0] - glow_surf.get_width() // 2
    gy = center_pos[1] - glow_surf.get_height() // 2

    surface.blit(glow_surf, (gx + 2, gy + 3))
    surface.blit(text_surf, (gx, gy))


def draw_coin_badge(surface, coins, pos):
    x, y = pos
    badge_rect = pygame.Rect(x, y, 110, 36)
    draw_panel(surface, badge_rect, radius=18, bg_color=(0, 0, 0, 120), border_color=GOLD)

